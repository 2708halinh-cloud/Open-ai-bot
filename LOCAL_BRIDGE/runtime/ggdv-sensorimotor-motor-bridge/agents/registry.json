      "id": "INTERMEDIATE-TRANSFORM-01",
      "class": "THIET_BI_TRUNG_GIAN",
      "project_semantics": "BAO_TOAN_NANG_LUONG_QUA_CHUYEN_HOA",
      "meaning": "Preserve causal/provenance continuity while state/data/config/instructions may transform.",
      "examples": [
        "IOTA",
        ".env",
        "CONFIG/*",
        "instruction files"
      ],
      "persistent_carrier_possible": true,
      "is_memory_by_default": false,
      "is_journal_by_default": false,
      "eternal_validity": false,
      "route": "STATE_N -> FRESH_READ -> DELTA -> TRANSFORM -> CONSEQUENCE -> READBACK -> STATE_N+1",
