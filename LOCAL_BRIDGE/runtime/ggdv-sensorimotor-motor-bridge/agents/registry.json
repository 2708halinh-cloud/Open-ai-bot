        "VALID_AT_STATE_N != ETERNAL_TRUTH",
        "PERSISTENT_FILE != MEMORY",
        "TRANSFORMATION != LOSS_OF_CONTINUITY",
        "STALE_RECHECK_BEFORE_ACTION"
