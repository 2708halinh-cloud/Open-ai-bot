{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TESSERACT Desktop",
  "version": "0.1.0",
  "identifier": "ggdv.tesseract.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TESSERACT Desktop",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:* https:; frame-src https: http:; img-src 'self' data: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "TESSERACT local-first agent workspace",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
